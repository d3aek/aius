{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.net/schemas/aius/source-request-schema.json",
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "pattern": "\\S"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "requestIdentifier": {
      "type": "string",
      "pattern": "^REQ-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[^\\s]+$",
      "format": "uri"
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "evidenceIdentifiers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identifier"
      },
      "uniqueItems": true
    }
  },
  "type": "object",
  "required": [
    "request_id",
    "family",
    "requirements",
    "authority_url",
    "selected_manufacturer",
    "selected_mpn",
    "source_id",
    "artifact_kinds",
    "status",
    "evidence_ids",
    "notes"
  ],
  "properties": {
    "request_id": {
      "$ref": "#/$defs/requestIdentifier"
    },
    "family": {
      "$ref": "#/$defs/slug"
    },
    "requirements": {
      "$ref": "#/$defs/nonEmptyUniqueStrings"
    },
    "authority_url": {
      "$ref": "#/$defs/httpsUrl"
    },
    "selected_manufacturer": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "selected_mpn": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "source_id": {
      "$ref": "#/$defs/identifier"
    },
    "artifact_kinds": {
      "type": "array",
      "items": {
        "enum": [
          "datasheet",
          "drawing",
          "cad",
          "product-page",
          "price-observation",
          "source-snapshot",
          "reference-design"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "status": {
      "enum": ["pending", "satisfied", "unavailable"]
    },
    "evidence_ids": {
      "$ref": "#/$defs/evidenceIdentifiers"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "pending"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "evidence_ids": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "satisfied"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "evidence_ids": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unavailable"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "evidence_ids": {
            "maxItems": 0
          },
          "notes": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    }
  ]
}
