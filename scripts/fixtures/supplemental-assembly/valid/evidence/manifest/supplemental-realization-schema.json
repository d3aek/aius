{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.net/schemas/aius/supplemental-realization-schema.json",
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "pattern": "\\S"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "requestId": {
      "type": "string",
      "pattern": "^REQ-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[^\\s]+$",
      "format": "uri"
    },
    "projectRelativePath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[{}$<>%`])\\S+$"
    },
    "ownedPath": {
      "allOf": [
        {
          "$ref": "#/$defs/projectRelativePath"
        },
        {
          "pattern": "^evidence/(?:manifest/supplemental-(?:fragments|assumption-fragments)/[A-Z0-9-]+\\.json|artifacts/[A-Z0-9-]+/[^/]+|source-snapshots/[A-Z0-9-]+/[^/]+)$"
        }
      ]
    },
    "safeBasename": {
      "type": "string",
      "pattern": "^(?!\\.{1,2}$)(?!.*[\\\\/])(?!.*[{}$<>%`])\\S(?:.*\\S)?$"
    },
    "scalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "constraint": {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "enum": ["const", "enum", "minimum", "exclusive-minimum", "pattern"]
        },
        "value": {}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "enum"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/scalar"
                },
                "minItems": 1,
                "uniqueItems": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["minimum", "exclusive-minimum"]
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "const"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/scalar"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "pattern"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^\\^\\S.*\\$$"
              }
            }
          }
        }
      ]
    },
    "field": {
      "type": "object",
      "required": ["key", "value_type", "nullable", "constraint", "unit", "source_role", "basis"],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        },
        "value_type": {
          "enum": ["string", "integer", "number", "boolean"]
        },
        "nullable": {
          "type": "boolean"
        },
        "constraint": {
          "$ref": "#/$defs/constraint"
        },
        "unit": {
          "anyOf": [
            {
              "$ref": "#/$defs/nonEmptyString"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_role": {
          "enum": ["product", "authorization"]
        },
        "basis": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "constraint": {
                "properties": {
                  "kind": {
                    "const": "pattern"
                  }
                },
                "required": ["kind"]
              }
            },
            "required": ["constraint"]
          },
          "then": {
            "properties": {
              "value_type": {
                "const": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "constraint": {
                "properties": {
                  "kind": {
                    "enum": ["minimum", "exclusive-minimum"]
                  }
                },
                "required": ["kind"]
              }
            },
            "required": ["constraint"]
          },
          "then": {
            "properties": {
              "value_type": {
                "enum": ["integer", "number"]
              }
            }
          }
        }
      ]
    },
    "observationProfile": {
      "type": "object",
      "required": ["name", "fields"],
      "properties": {
        "name": {
          "const": "uk-distributor-price-stock"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          },
          "minItems": 17,
          "maxItems": 17,
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "required": ["status", "authority", "method", "initial_url", "basis"],
      "properties": {
        "status": {
          "enum": ["confirmed", "unresolved"]
        },
        "authority": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "method": {
          "enum": ["manufacturer-page", "manufacturer-locator", "ecia-trustedparts-exception"]
        },
        "initial_url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "basis": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "ecia-trustedparts-exception"
              }
            },
            "required": ["method"]
          },
          "then": {
            "properties": {
              "authority": {
                "const": "ECIA TrustedParts"
              },
              "initial_url": {
                "const": "https://www.trustedparts.com/en/manufacturers/tag-connect"
              }
            }
          }
        }
      ]
    },
    "cloneOutcome": {
      "type": "object",
      "required": ["source_id", "classification", "reused_material", "derived_claims", "prohibited_use", "notes"],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/identifier"
        },
        "classification": {
          "enum": ["official-reuse", "unresolved"]
        },
        "reused_material": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        },
        "derived_claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "prohibited_use": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "cloneBoundary": {
      "type": "object",
      "required": ["current", "unavailable"],
      "properties": {
        "current": {
          "allOf": [
            {
              "$ref": "#/$defs/cloneOutcome"
            },
            {
              "properties": {
                "classification": {
                  "const": "official-reuse"
                },
                "reused_material": {
                  "const": ["Retained primary manufacturer evidence."]
                },
                "derived_claims": {
                  "const": ["Aius requirements are bounded by the retained primary manufacturer evidence."]
                },
                "prohibited_use": {
                  "const": ["Do not treat the manufacturer material as a complete Aius design."]
                },
                "notes": {
                  "const": ""
                }
              }
            }
          ]
        },
        "unavailable": {
          "allOf": [
            {
              "$ref": "#/$defs/cloneOutcome"
            },
            {
              "properties": {
                "classification": {
                  "const": "unresolved"
                },
                "reused_material": {
                  "const": []
                },
                "derived_claims": {
                  "const": ["The manufacturer claim remains unresolved."]
                },
                "prohibited_use": {
                  "const": [
                    "Do not select or release the component until current manufacturer evidence replaces the unavailable source."
                  ]
                },
                "notes": {
                  "const": "The fixed manufacturer source is unavailable."
                }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["artifact_kind", "name", "retrieval_url", "expected_final_url", "path", "storage", "media_type"],
      "properties": {
        "artifact_kind": {
          "enum": ["datasheet", "drawing", "product-page"]
        },
        "name": {
          "$ref": "#/$defs/safeBasename"
        },
        "retrieval_url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "expected_final_url": {
          "$ref": "#/$defs/httpsUrl"
        },
        "path": {
          "$ref": "#/$defs/projectRelativePath"
        },
        "storage": {
          "enum": ["lfs", "git"]
        },
        "media_type": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "realization": {
      "type": "object",
      "required": [
        "request_id",
        "task_name",
        "owned_paths",
        "source_id",
        "authority",
        "revision_strategy",
        "revision_value",
        "observation_url",
        "authorization",
        "clone_boundary",
        "artifacts",
        "observation_profile",
        "failure_policy",
        "retention",
        "notes"
      ],
      "properties": {
        "request_id": {
          "$ref": "#/$defs/requestId"
        },
        "task_name": {
          "type": "string",
          "pattern": "^component-evidence-req-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "owned_paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ownedPath"
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "source_id": {
          "$ref": "#/$defs/identifier"
        },
        "authority": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "revision_strategy": {
          "enum": ["sha256", "observation-date"]
        },
        "revision_value": {
          "type": "null"
        },
        "observation_url": {
          "anyOf": [
            {
              "$ref": "#/$defs/httpsUrl"
            },
            {
              "type": "null"
            }
          ]
        },
        "authorization": {
          "anyOf": [
            {
              "$ref": "#/$defs/authorization"
            },
            {
              "type": "null"
            }
          ]
        },
        "clone_boundary": {
          "anyOf": [
            {
              "$ref": "#/$defs/cloneBoundary"
            },
            {
              "type": "null"
            }
          ]
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "uniqueItems": true
        },
        "observation_profile": {
          "anyOf": [
            {
              "const": "uk-distributor-price-stock"
            },
            {
              "type": "null"
            }
          ]
        },
        "failure_policy": {
          "enum": ["golden-block", "assumption"]
        },
        "retention": {
          "enum": ["personal-noncommercial-no-republication", "normalized-observation-only"]
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "revision_strategy": {
                "const": "sha256"
              }
            },
            "required": ["revision_strategy"]
          },
          "then": {
            "properties": {
              "observation_url": {
                "const": null
              },
              "authorization": {
                "const": null
              },
              "clone_boundary": {
                "$ref": "#/$defs/cloneBoundary"
              },
              "artifacts": {
                "minItems": 1
              },
              "observation_profile": {
                "const": null
              },
              "failure_policy": {
                "const": "golden-block"
              },
              "retention": {
                "const": "personal-noncommercial-no-republication"
              }
            }
          },
          "else": {
            "properties": {
              "observation_url": {
                "$ref": "#/$defs/httpsUrl"
              },
              "authorization": {
                "$ref": "#/$defs/authorization"
              },
              "clone_boundary": {
                "const": null
              },
              "artifacts": {
                "maxItems": 0
              },
              "observation_profile": {
                "const": "uk-distributor-price-stock"
              },
              "failure_policy": {
                "const": "assumption"
              },
              "retention": {
                "const": "normalized-observation-only"
              }
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "required": ["schema_version", "owned_path_root", "observation_profiles", "realizations"],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "owned_path_root": {
      "const": "src/hardware/aius"
    },
    "observation_profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observationProfile"
      },
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true
    },
    "realizations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/realization"
      },
      "minItems": 46,
      "maxItems": 46,
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
