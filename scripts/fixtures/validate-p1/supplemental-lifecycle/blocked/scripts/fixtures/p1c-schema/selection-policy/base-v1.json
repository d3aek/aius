{
  "schema_version": "1.0.0",
  "engineering_policies": [
    {
      "id": "EP-MANUFACTURABILITY-SMALL-RUN",
      "scope": "manufacturability",
      "rule": "Prefer packages, footprints, and connector geometries compatible with repeatable small-run assembly, inspection, rework, and hand-machined enclosure openings.",
      "validation_gate": "H2 placement and assembly review",
      "notes": ""
    },
    {
      "id": "EP-PRODUCT-SINGLE-POWER-ENTRY",
      "scope": "product-topology",
      "rule": "Use rear USB-C VBUS as the sole normal power entry; do not fit a second VIN/VUSB feed or permit an expansion rail to power the core.",
      "validation_gate": "H1 schematic power-path review",
      "notes": ""
    },
    {
      "id": "EP-PROVISIONAL-GENERIC-PASSIVES",
      "scope": "provisional-design-choice",
      "rule": "Use the locked provisional value, package, and tolerance tuple for each generic allowance until its later electrical or schematic gate passes.",
      "validation_gate": "P1D electrical analysis and H1 schematic review",
      "notes": ""
    },
    {
      "id": "EP-PROVISIONAL-TWO-LAYER-BOARD",
      "scope": "provisional-design-choice",
      "rule": "Keep the backplane compatible with the approved two-layer stack-up unless measured or routed evidence at P1D/H2 requires four layers.",
      "validation_gate": "H2 placement and routing review",
      "notes": ""
    },
    {
      "id": "EP-SAFE-EXPANSION-UNPOWERED",
      "scope": "safe-default",
      "rule": "An unpowered expansion must not sustain any core or expansion rail; exported signals shall be high impedance or current limited.",
      "validation_gate": "P1D powered-off leakage and clamp-current validation",
      "notes": ""
    },
    {
      "id": "EP-SAFE-OPTICAL-DEFAULTS",
      "scope": "safe-default",
      "rule": "Default the S/PDIF path to processed audio and hold optical transmit disabled through absence, reset, boot, switching, brownout, and watchdog recovery.",
      "validation_gate": "H1 schematic pull-state review and P7 fault-injection test",
      "notes": ""
    },
    {
      "id": "EP-SOURCING-MANUFACTURER-AUTHORITY",
      "scope": "sourcing",
      "rule": "A non-generic candidate requires retained primary manufacturer evidence before it can be selected.",
      "validation_gate": "P1E sourcing evidence review",
      "notes": ""
    },
    {
      "id": "EP-SOURCING-UK-AVAILABILITY",
      "scope": "sourcing",
      "rule": "A non-generic candidate requires a separately recorded UK authorized-distributor availability observation.",
      "validation_gate": "P1E UK availability review",
      "notes": ""
    }
  ],
  "requirements": [
    {
      "id": "REQT-COMMON-ENCLOSURE-CLEARANCE",
      "statement": "The selected part and its mating cable or module shall fit the Hammond 1455N1201BK internal envelope and preserve the documented rear or user-access clearance.",
      "basis_ids": ["HAMMOND-1455N1201BK-DRAWING", "HAMMOND-1455N1201BK-STEP"],
      "verification_stage": "P1D-mechanical",
      "notes": ""
    },
    {
      "id": "REQT-COMMON-MANUFACTURABILITY",
      "statement": "The selected package, footprint, retention method, and assembly process shall remain feasible for a repeatable small run on the provisional two-layer board.",
      "basis_ids": ["EP-MANUFACTURABILITY-SMALL-RUN", "EP-PROVISIONAL-TWO-LAYER-BOARD"],
      "verification_stage": "H2-placement",
      "notes": ""
    },
    {
      "id": "REQT-COMMON-MANUFACTURER-EVIDENCE",
      "statement": "The selected non-generic candidate shall have retained primary manufacturer evidence covering every requirement assigned to its family.",
      "basis_ids": ["EP-SOURCING-MANUFACTURER-AUTHORITY"],
      "verification_stage": "P1E-sourcing",
      "notes": ""
    },
    {
      "id": "REQT-COMMON-UK-AVAILABILITY",
      "statement": "The selected non-generic candidate shall have a separately recorded current UK authorized-distributor availability observation.",
      "basis_ids": ["EP-SOURCING-UK-AVAILABILITY"],
      "verification_stage": "P1E-sourcing",
      "notes": ""
    },
    {
      "id": "REQT-ETHERNET-CENTER-TAP-CAPACITOR",
      "statement": "Use a 100 nF, 0402, 10% generic capacitor at the Ethernet transformer centre-tap node identified by the PJRC reference.",
      "basis_ids": ["EP-PROVISIONAL-GENERIC-PASSIVES", "PJRC-ETHERNET-KIT"],
      "verification_stage": "H1-schematic",
      "notes": ""
    },
    {
      "id": "REQT-ETHERNET-MAGJACK",
      "statement": "The magjack shall match the Teensy 4.1 native DP83825 magnetics requirements for turns ratio, pinout, centre taps, isolation, LEDs, and shield connection.",
      "basis_ids": ["PJRC-ETHERNET-KIT", "PJRC-TEENSY41-SCHEMATIC"],
      "verification_stage": "H1-schematic",
      "notes": ""
    },
    {
      "id": "REQT-EXPANSION-GPIO-ADC-CONNECTOR",
      "statement": "Provide a keyed four-circuit 3.3 V expansion connector carrying one GPIO, one ADC input, 3.3 V, and ground with documented mating geometry.",
      "basis_ids": ["EP-MANUFACTURABILITY-SMALL-RUN", "PJRC-TEENSY41-PINOUT"],
      "verification_stage": "H1-schematic",
      "notes": ""
    },
    {
      "id": "REQT-EXPANSION-I2C-CONTROL-CONNECTOR",
      "statement": "Provide a keyed four-circuit expansion connector carrying I2C SCL, I2C SDA, expansion 3.3 V, and ground with documented mating geometry.",
      "basis_ids": ["EP-MANUFACTURABILITY-SMALL-RUN", "PJRC-TEENSY41-PINOUT"],
      "verification_stage": "H1-schematic",
      "notes": ""
    },
    {
      "id": "REQT-EXPANSION-I2C-ISOLATION",
      "statement": "The interface shall support the 3.3 V control bus and present powered-off high impedance in both directions without sustaining either rail.",
      "basis_ids": ["EP-SAFE-EXPANSION-UNPOWERED", "PJRC-IMXRT1060-RM"],
      "verification_stage": "P1D-electrical",
      "notes": ""
    },
    {
      "id": "REQT-EXPANSION-I2S-TDM-CONNECTOR",
      "statement": "Provide a keyed five-circuit expansion connector carrying I2S BCLK, LRCLK, data, expansion 3.3 V, and ground with documented mating geometry.",
      "basis_ids": ["EP-MANUFACTURABILITY-SMALL-RUN", "PJRC-TEENSY41-PINOUT"],
      "verification_stage": "H1-schematic",
      "notes": ""
    },
    {
      "id": "REQT-EXPANSION-IO-SERIES-RESISTOR",
      "statement": "Use a 1 kOhm, 0402, 1% generic series resistor on each exported single-ended CMOS signal that relies on bounded clamp current.",
      "basis_ids": ["EP-PROVISIONAL-GENERIC-PASSIVES", "EP-SAFE-EXPANSION-UNPOWERED"],
      "verification_stage": "P1D-electrical",
      "notes": ""
    },
    {
      "id": "REQT-EXPANSION-POWER-PROTECTION",
      "statement": "The selected protection device shall block reverse current, limit fault current, and meet powered-off leakage limits when used on either protected expansion rail.",
      "basis_ids": ["EP-PRODUCT-SINGLE-POWER-ENTRY", "EP-SAFE-EXPANSION-UNPOWERED"],
      "verification_stage": "P1D-electrical",
      "notes": ""
    },
    {
      "id": "REQT-EXPANSION-SPI-CONNECTOR",
      "statement": "Provide a keyed six-circuit expansion connector carrying SPI SCK, MOSI, MISO, CS, expansion 3.3 V, and ground with documented mating geometry.",
      "basis_ids": ["EP-MANUFACTURABILITY-SMALL-RUN", "PJRC-TEENSY41-PINOUT"],
      "verification_stage": "H1-schematic",
      "notes": ""
    },
    {
      "id": "REQT-EXPANSION-UART-DEBUG-CONNECTOR",
      "statement": "Provide a keyed four-circuit expansion connector carrying UART TX, UART RX, expansion 3.3 V, and ground with documented mating geometry.",
      "basis_ids": ["EP-MANUFACTURABILITY-SMALL-RUN", "PJRC-TEENSY41-PINOUT"],
      "verification_stage": "H1-schematic",
      "notes": ""
    },
    {
      "id": "REQT-EXPANSION-USB-HOST-CONNECTOR",
      "statement": "Provide a keyed four-circuit USB 2.0 host connector carrying D+, D-, protected VBUS, and ground with documented current rating and mating geometry.",
      "basis_ids": ["EP-SAFE-EXPANSION-UNPOWERED", "PJRC-IMXRT1060-RM", "PJRC-TEENSY41-PINOUT"],
      "verification_stage": "H1-schematic",
      "notes": ""
    },
    {
      "id": "REQT-LOGIC-CONTROL-PULLDOWN",
      "statement": "Use a 10 kOhm, 0402, 1% generic pull-down for the S/PDIF path-select and optical-transmit-enable hardware-safe defaults.",
      "basis_ids": ["EP-PROVISIONAL-GENERIC-PASSIVES", "EP-SAFE-OPTICAL-DEFAULTS"],
      "verification_stage": "P1D-electrical",
      "notes": ""
    },
    {
      "id": "REQT-LOGIC-DECOUPLING",
      "statement": "Use a 100 nF, 0402, 10% generic local decoupling capacitor at each selected 3.3 V logic device supply.",
      "basis_ids": ["EP-MANUFACTURABILITY-SMALL-RUN", "EP-PROVISIONAL-GENERIC-PASSIVES"],
      "verification_stage": "H2-placement",
      "notes": ""
    },
    {
      "id": "REQT-MECHANICAL-CABLE-RETAINER",
      "statement": "The retainer shall secure the internal USB-A-to-Micro-B cable against insertion and vibration load without stressing the Teensy module or enclosure.",
      "basis_ids": ["EP-MANUFACTURABILITY-SMALL-RUN", "HAMMOND-1455N1201BK-DRAWING", "HAMMOND-1455N1201BK-STEP"],
      "verification_stage": "P1D-mechanical",
      "notes": ""
    },
    {
      "id": "REQT-OPTICAL-BANDWIDTH",
      "statement": "Every active logic element between the optical receiver and transmitter shall support at least 16 Mbit/s.",
      "basis_ids": ["CLIFF-ORJ5", "CLIFF-OTJ5", "PJRC-SPDIF-RX-SOURCE", "PJRC-SPDIF-TX-SOURCE"],
      "verification_stage": "P1D-electrical",
      "notes": ""
    },
    {
      "id": "REQT-OPTICAL-LOGIC-COMPATIBILITY",
      "statement": "The 3.3 V optical path shall accept the ORJ5 2.4 V minimum high output and drive the OTJ5 2.0 V minimum high input with documented margin.",
      "basis_ids": ["CLIFF-ORJ5", "CLIFF-OTJ5", "PJRC-IMXRT1060-CEC"],
      "verification_stage": "P1D-electrical",
      "notes": ""
    },
    {
      "id": "REQT-OPTICAL-PROCESSED-DEFAULT",
      "statement": "Hardware pulls and gating shall select the processed S/PDIF path, prevent driver contention, hold transmit disabled during selection changes, and return disabled after reset.",
      "basis_ids": ["EP-SAFE-OPTICAL-DEFAULTS"],
      "verification_stage": "H1-schematic",
      "notes": ""
    },
    {
      "id": "REQT-REMOTE-PROGRAM-RTC",
      "statement": "Provide a rear-service interface for PROGRAM and RTC battery with ground reference, correct Teensy pinout, documented mating geometry, and no second core power path.",
      "basis_ids": ["EP-PRODUCT-SINGLE-POWER-ENTRY", "PJRC-TEENSY41-PINOUT", "PJRC-TEENSY41-SCHEMATIC"],
      "verification_stage": "H1-schematic",
      "notes": ""
    },
    {
      "id": "REQT-TEENSY-ETHERNET-SOCKET",
      "statement": "The socket interface shall reproduce the PJRC native Ethernet header pin order, mating height, and mechanical retention.",
      "basis_ids": ["PJRC-ETHERNET-KIT", "PJRC-TEENSY41-PINOUT"],
      "verification_stage": "H1-schematic",
      "notes": ""
    },
    {
      "id": "REQT-TEENSY-SIDE-SOCKET",
      "statement": "The two side socket rows shall mate the Teensy 4.1 pin field, preserve underside clearance, permit module removal, and retain microSD access.",
      "basis_ids": ["HAMMOND-1455N1201BK-DRAWING", "PJRC-TEENSY41-PAGE", "PJRC-TEENSY41-PINOUT"],
      "verification_stage": "H2-placement",
      "notes": ""
    },
    {
      "id": "REQT-TEENSY-USB-HOST-SOCKET",
      "statement": "The socket shall match the Teensy 4.1 USB-host pads and pinout, carry D+, D-, VBUS, and ground, and prevent reverse supply into an unpowered domain.",
      "basis_ids": ["EP-SAFE-EXPANSION-UNPOWERED", "PJRC-TEENSY41-PINOUT", "PJRC-TEENSY41-SCHEMATIC"],
      "verification_stage": "H1-schematic",
      "notes": ""
    },
    {
      "id": "REQT-TEST-FIXTURE-HEADER",
      "statement": "The fixture header shall expose test control, test data, 3.3 V, and ground with keyed repeatable mating that does not load user connectors.",
      "basis_ids": ["EP-MANUFACTURABILITY-SMALL-RUN", "PJRC-IMXRT1060-RM", "PJRC-TEENSY41-PINOUT"],
      "verification_stage": "H2-placement",
      "notes": ""
    },
    {
      "id": "REQT-USB-A-RECEPTACLE",
      "statement": "The internal USB-A receptacle shall carry USB 2.0 D+, D-, protected VBUS, and ground and accept the internal cable within the enclosure envelope.",
      "basis_ids": ["HAMMOND-1455N1201BK-DRAWING", "PJRC-TEENSY41-SCHEMATIC"],
      "verification_stage": "H1-schematic",
      "notes": ""
    },
    {
      "id": "REQT-USB-C-CC-PULLDOWN",
      "statement": "Use one independent 5.1 kOhm, 0402, 1% generic pull-down from each USB-C CC pin to ground.",
      "basis_ids": ["EP-PRODUCT-SINGLE-POWER-ENTRY", "EP-PROVISIONAL-GENERIC-PASSIVES"],
      "verification_stage": "P1D-electrical",
      "notes": ""
    },
    {
      "id": "REQT-USB-C-RECEPTACLE",
      "statement": "The rear USB-C receptacle shall expose USB 2.0 D+, D-, independent CC1 and CC2, VBUS, ground, and shield with documented footprint, shell, and mating geometry.",
      "basis_ids": ["EP-PRODUCT-SINGLE-POWER-ENTRY", "HAMMOND-1455N1201BK-DRAWING", "PJRC-TEENSY41-SCHEMATIC"],
      "verification_stage": "H1-schematic",
      "notes": ""
    },
    {
      "id": "REQT-USB-ESD",
      "statement": "The ESD device shall protect both USB D+ and D- with low capacitance and flow-through routing compatible with USB 2.0 high speed and the provisional two-layer 90 ohm differential route.",
      "basis_ids": ["EP-PROVISIONAL-TWO-LAYER-BOARD", "PJRC-IMXRT1060-CEC", "PJRC-IMXRT1060-RM"],
      "verification_stage": "P1D-electrical",
      "notes": ""
    },
    {
      "id": "REQT-USB-INTERNAL-CABLE",
      "statement": "The internal USB-A-plug-to-Micro-B-plug cable shall carry D+, D-, VBUS, and ground, support USB 2.0 high speed, fit the enclosure envelope, and accept the cable retainer.",
      "basis_ids": ["HAMMOND-1455N1201BK-DRAWING", "PJRC-TEENSY41-SCHEMATIC"],
      "verification_stage": "P1D-mechanical",
      "notes": ""
    },
    {
      "id": "REQT-USB-POWER-PROTECTION",
      "statement": "The sole VBUS protection path shall bound inrush, overload, thermal fault, input loss, and reverse-current or backfeed behavior.",
      "basis_ids": ["EP-PRODUCT-SINGLE-POWER-ENTRY", "PJRC-TEENSY41-SCHEMATIC"],
      "verification_stage": "P1D-electrical",
      "notes": ""
    }
  ],
