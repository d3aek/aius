{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.net/schemas/aius/interfaces-and-states-schema.json",
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "pattern": "\\S"
    },
    "evidenceIdentifier": {
      "type": "string",
      "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "evidenceIdentifiers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceIdentifier"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "nonEmptyUniqueStrings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "powerDomainIdentifier": {
      "enum": [
        "usb-vbus-raw",
        "protected-5v",
        "teensy-3v3",
        "rtc-backup",
        "digital-ground",
        "chassis-shield",
        "expansion-3v3",
        "expansion-usb-host-vbus"
      ]
    },
    "powerDomainIdentifiers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/powerDomainIdentifier"
      },
      "uniqueItems": true
    },
    "operatingStateIdentifier": {
      "enum": [
        "power-off",
        "powered-reset",
        "boot-muted",
        "waiting-for-carrier",
        "pcm-active",
        "dts-active",
        "unsupported-muted",
        "diagnostic-bypass",
        "fault-muted"
      ]
    },
    "pathOutcome": {
      "enum": ["processed", "raw"]
    },
    "txOutcome": {
      "enum": ["disabled", "enabled-pcm", "enabled-raw", "unchanged"]
    },
    "payloadOutcome": {
      "enum": ["none", "pcm-silence-48k", "processed-pcm-48k", "raw-spdif", "unchanged"]
    },
    "expansionOutcome": {
      "enum": ["high-impedance", "current-limited", "active", "unchanged"]
    },
    "safeValue": {
      "enum": [
        "processed",
        "raw",
        "disabled",
        "enabled-pcm",
        "enabled-raw",
        "unchanged",
        "none",
        "pcm-silence-48k",
        "processed-pcm-48k",
        "raw-spdif",
        "high-impedance",
        "current-limited",
        "active",
        "asserted",
        "deasserted",
        "low",
        "high"
      ]
    },
    "action": {
      "enum": [
        "disable-tx",
        "wait-muted",
        "select-processed",
        "select-raw",
        "clear-pipeline",
        "prime-pcm-silence",
        "enable-tx-pcm",
        "enable-tx-raw",
        "assert-reset",
        "hold-expansion-safe"
      ]
    },
    "precondition": {
      "enum": [
        "rails-valid",
        "watchdog-armed",
        "pipeline-primed",
        "carrier-present",
        "format-supported",
        "output-muted",
        "tx-disabled",
        "diagnostic-authorized"
      ]
    },
    "postcondition": {
      "enum": [
        "processed-selected",
        "raw-selected",
        "tx-disabled",
        "tx-pcm-enabled",
        "tx-raw-enabled",
        "expansion-safe"
      ]
    },
    "connector": {
      "type": "object",
      "required": ["id", "location", "role", "signals", "power_domains", "mating_constraint", "evidence_ids", "notes"],
      "properties": {
        "id": {
          "enum": [
            "rear-usb-c",
            "internal-usb-a",
            "teensy-micro-b",
            "toslink-rx",
            "toslink-tx",
            "ethernet-rj45",
            "microsd-access",
            "remote-program-rtc",
            "test-fixture"
          ]
        },
        "location": {
          "enum": ["rear", "internal", "module", "user-access"]
        },
        "role": {
          "enum": ["power-data", "data", "optical", "network", "storage-access", "control", "test"]
        },
        "signals": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "power_domains": {
          "$ref": "#/$defs/powerDomainIdentifiers"
        },
        "mating_constraint": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidenceIdentifiers"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "control": {
      "type": "object",
      "required": ["id", "owner", "active_level", "reset_default", "safe_value", "evidence_ids", "notes"],
      "properties": {
        "id": {
          "enum": [
            "spdif-path-select",
            "optical-tx-enable",
            "teensy-reset",
            "teensy-watchdog",
            "program-control",
            "status-led"
          ]
        },
        "owner": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "active_level": {
          "enum": ["high", "low", "not-applicable"]
        },
        "reset_default": {
          "$ref": "#/$defs/safeValue"
        },
        "safe_value": {
          "$ref": "#/$defs/safeValue"
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidenceIdentifiers"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "expansionInterface": {
      "type": "object",
      "required": [
        "id",
        "direction",
        "signals",
        "power_domains",
        "powered_behavior",
        "unpowered_behavior",
        "protection_method",
        "backfeed_rule",
        "evidence_ids",
        "notes"
      ],
      "properties": {
        "id": {
          "enum": [
            "expansion-i2c-control",
            "expansion-spi",
            "expansion-uart-debug",
            "expansion-i2s-tdm",
            "expansion-usb-host",
            "expansion-gpio-adc"
          ]
        },
        "direction": {
          "enum": ["input", "output", "bidirectional"]
        },
        "signals": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "power_domains": {
          "$ref": "#/$defs/powerDomainIdentifiers"
        },
        "powered_behavior": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "unpowered_behavior": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "protection_method": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "backfeed_rule": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidenceIdentifiers"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "powerDomain": {
      "type": "object",
      "required": ["id", "source", "consumers", "backfeed_rule", "evidence_ids", "notes"],
      "properties": {
        "id": {
          "$ref": "#/$defs/powerDomainIdentifier"
        },
        "source": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "consumers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        },
        "backfeed_rule": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidenceIdentifiers"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "operatingState": {
      "type": "object",
      "required": [
        "id",
        "entry_condition",
        "path_select",
        "tx_state",
        "output_payload",
        "expansion_state",
        "exit_condition",
        "notes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/operatingStateIdentifier"
        },
        "entry_condition": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "path_select": {
          "$ref": "#/$defs/pathOutcome"
        },
        "tx_state": {
          "$ref": "#/$defs/txOutcome"
        },
        "output_payload": {
          "$ref": "#/$defs/payloadOutcome"
        },
        "expansion_state": {
          "$ref": "#/$defs/expansionOutcome"
        },
        "exit_condition": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "faultScenario": {
      "type": "object",
      "required": [
        "id",
        "trigger",
        "path_select",
        "tx_state",
        "output_payload",
        "expansion_state",
        "hardware_pull_required",
        "watchdog_required",
        "debounce_measurement_gate",
        "residual_interval_measurement_gate",
        "actions",
        "recovery_state",
        "notes"
      ],
      "properties": {
        "id": {
          "enum": [
            "teensy-absent",
            "boot",
            "reset",
            "brownout",
            "firmware-crash",
            "optical-carrier-loss",
            "unsupported-burst",
            "malformed-input",
            "usb-unplug",
            "raw-bypass-request",
            "unpowered-expansion"
          ]
        },
        "trigger": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "path_select": {
          "$ref": "#/$defs/pathOutcome"
        },
        "tx_state": {
          "$ref": "#/$defs/txOutcome"
        },
        "output_payload": {
          "$ref": "#/$defs/payloadOutcome"
        },
        "expansion_state": {
          "$ref": "#/$defs/expansionOutcome"
        },
        "hardware_pull_required": {
          "type": "boolean"
        },
        "watchdog_required": {
          "type": "boolean"
        },
        "debounce_measurement_gate": {
          "anyOf": [
            {
              "enum": ["P6", "P7"]
            },
            {
              "type": "null"
            }
          ]
        },
        "residual_interval_measurement_gate": {
          "anyOf": [
            {
              "const": "P7"
            },
            {
              "type": "null"
            }
          ]
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          },
          "uniqueItems": true
        },
        "recovery_state": {
          "$ref": "#/$defs/operatingStateIdentifier"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "id": {
                "const": "teensy-absent"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "path_select": {
                "const": "processed"
              },
              "tx_state": {
                "const": "disabled"
              },
              "output_payload": {
                "const": "none"
              },
              "expansion_state": {
                "enum": ["high-impedance", "current-limited"]
              },
              "hardware_pull_required": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "boot"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "path_select": {
                "const": "processed"
              },
              "tx_state": {
                "const": "disabled"
              },
              "output_payload": {
                "const": "none"
              },
              "expansion_state": {
                "enum": ["high-impedance", "current-limited"]
              },
              "watchdog_required": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "reset"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "path_select": {
                "const": "processed"
              },
              "tx_state": {
                "const": "disabled"
              },
              "output_payload": {
                "const": "none"
              },
              "expansion_state": {
                "enum": ["high-impedance", "current-limited"]
              },
              "hardware_pull_required": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "brownout"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "path_select": {
                "const": "processed"
              },
              "tx_state": {
                "const": "disabled"
              },
              "output_payload": {
                "const": "none"
              },
              "expansion_state": {
                "enum": ["high-impedance", "current-limited"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "firmware-crash"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "path_select": {
                "const": "processed"
              },
              "tx_state": {
                "const": "disabled"
              },
              "output_payload": {
                "const": "none"
              },
              "expansion_state": {
                "enum": ["high-impedance", "current-limited"]
              },
              "watchdog_required": {
                "const": true
              },
              "residual_interval_measurement_gate": {
                "const": "P7"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "optical-carrier-loss"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "path_select": {
                "const": "processed"
              },
              "tx_state": {
                "const": "disabled"
              },
              "output_payload": {
                "const": "none"
              },
              "expansion_state": {
                "const": "unchanged"
              },
              "debounce_measurement_gate": {
                "enum": ["P6", "P7"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "unsupported-burst"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "path_select": {
                "const": "processed"
              },
              "tx_state": {
                "const": "enabled-pcm"
              },
              "output_payload": {
                "const": "pcm-silence-48k"
              },
              "expansion_state": {
                "const": "unchanged"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "malformed-input"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "path_select": {
                "const": "processed"
              },
              "tx_state": {
                "const": "enabled-pcm"
              },
              "output_payload": {
                "const": "pcm-silence-48k"
              },
              "expansion_state": {
                "const": "unchanged"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "usb-unplug"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "path_select": {
                "const": "processed"
              },
              "tx_state": {
                "const": "disabled"
              },
              "output_payload": {
                "const": "none"
              },
              "expansion_state": {
                "enum": ["high-impedance", "current-limited"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "raw-bypass-request"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "path_select": {
                "const": "raw"
              },
              "tx_state": {
                "const": "enabled-raw"
              },
              "output_payload": {
                "const": "raw-spdif"
              },
              "expansion_state": {
                "const": "unchanged"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "unpowered-expansion"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "path_select": {
                "const": "processed"
              },
              "tx_state": {
                "const": "unchanged"
              },
              "output_payload": {
                "const": "unchanged"
              },
              "expansion_state": {
                "enum": ["high-impedance", "current-limited"]
              }
            }
          }
        }
      ]
    },
    "transition": {
      "type": "object",
      "required": ["id", "from_states", "to_states", "triggers", "preconditions", "actions", "postconditions", "notes"],
      "properties": {
        "id": {
          "enum": [
            "power-on-to-reset",
            "reset-to-boot",
            "boot-to-waiting",
            "waiting-to-pcm",
            "waiting-to-dts",
            "active-to-carrier-loss",
            "active-to-unsupported",
            "unsupported-to-active",
            "active-to-diagnostic-bypass",
            "diagnostic-bypass-to-waiting",
            "watchdog-to-reset",
            "usb-unplug-to-power-off"
          ]
        },
        "from_states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operatingStateIdentifier"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "to_states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operatingStateIdentifier"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "triggers": {
          "type": "array",
          "items": {
            "enum": [
              "power-applied",
              "reset-released",
              "pipeline-ready",
              "pcm-detected",
              "dts-detected",
              "optical-carrier-loss",
              "unsupported-burst",
              "malformed-input",
              "supported-format-detected",
              "raw-bypass-request",
              "raw-bypass-release",
              "watchdog-expired",
              "usb-unplug"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "preconditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/precondition"
          },
          "uniqueItems": true
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          },
          "minItems": 1
        },
        "postconditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/postcondition"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "id": {
                "const": "power-on-to-reset"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "from_states": {
                "const": ["power-off"]
              },
              "to_states": {
                "const": ["powered-reset"]
              },
              "triggers": {
                "const": ["power-applied"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "reset-to-boot"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "from_states": {
                "const": ["powered-reset"]
              },
              "to_states": {
                "const": ["boot-muted"]
              },
              "triggers": {
                "const": ["reset-released"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "boot-to-waiting"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "from_states": {
                "const": ["boot-muted"]
              },
              "to_states": {
                "const": ["waiting-for-carrier"]
              },
              "triggers": {
                "const": ["pipeline-ready"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "waiting-to-pcm"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "from_states": {
                "const": ["waiting-for-carrier"]
              },
              "to_states": {
                "const": ["pcm-active"]
              },
              "triggers": {
                "const": ["pcm-detected"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "waiting-to-dts"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "from_states": {
                "const": ["waiting-for-carrier"]
              },
              "to_states": {
                "const": ["dts-active"]
              },
              "triggers": {
                "const": ["dts-detected"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "active-to-carrier-loss"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "from_states": {
                "const": ["pcm-active", "dts-active", "unsupported-muted", "diagnostic-bypass"]
              },
              "to_states": {
                "const": ["waiting-for-carrier"]
              },
              "triggers": {
                "const": ["optical-carrier-loss"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "active-to-unsupported"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "from_states": {
                "const": ["pcm-active", "dts-active"]
              },
              "to_states": {
                "const": ["unsupported-muted"]
              },
              "triggers": {
                "const": ["unsupported-burst", "malformed-input"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "unsupported-to-active"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "from_states": {
                "const": ["unsupported-muted"]
              },
              "to_states": {
                "const": ["pcm-active", "dts-active"]
              },
              "triggers": {
                "const": ["supported-format-detected"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "active-to-diagnostic-bypass"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "from_states": {
                "const": ["pcm-active", "dts-active", "unsupported-muted"]
              },
              "to_states": {
                "const": ["diagnostic-bypass"]
              },
              "triggers": {
                "const": ["raw-bypass-request"]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "diagnostic-bypass-to-waiting"
              }
            },
            "required": ["id"]
          },
          "then": {
            "properties": {
              "from_states": {
                "const": ["diagnostic-bypass"]
              },
              "to_states": {
                "const": ["waiting-for-carrier"]
              },
