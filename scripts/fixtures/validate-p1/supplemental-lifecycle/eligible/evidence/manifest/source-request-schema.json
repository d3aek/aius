{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.net/schemas/aius/source-request-schema.json",
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "pattern": "\\S"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "requirementIdentifier": {
      "type": "string",
      "pattern": "^REQT-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
    },
    "manufacturerRequestIdentifier": {
      "type": "string",
      "pattern": "^REQ-[A-Z0-9]+(?:-[A-Z0-9]+)*-MFR$"
    },
    "availabilityRequestIdentifier": {
      "type": "string",
      "pattern": "^REQ-[A-Z0-9]+(?:-[A-Z0-9]+)*-UK$"
    },
    "manufacturerSourceIdentifier": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^AIUS-[A-Z0-9]+(?:-[A-Z0-9]+)*-MFR$"
        },
        {
          "enum": ["CLIFF-ORJ5", "CLIFF-OTJ5"]
        }
      ]
    },
    "availabilitySourceIdentifier": {
      "type": "string",
      "pattern": "^AIUS-[A-Z0-9]+(?:-[A-Z0-9]+)*-UK$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[^\\s]+$",
      "format": "uri"
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirementIdentifier"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "evidenceIdentifiers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identifier"
      },
      "uniqueItems": true
    }
  },
  "type": "object",
  "required": [
    "request_id",
    "request_kind",
    "family",
    "requirements",
    "authority_url",
    "selected_manufacturer",
    "selected_mpn",
    "source_id",
    "artifact_kinds",
    "retention",
    "status",
    "evidence_ids",
    "notes"
  ],
  "properties": {
    "request_id": {
      "anyOf": [
        { "$ref": "#/$defs/manufacturerRequestIdentifier" },
        { "$ref": "#/$defs/availabilityRequestIdentifier" }
      ]
    },
    "request_kind": {
      "enum": ["manufacturer-evidence", "uk-availability"]
    },
    "family": {
      "$ref": "#/$defs/slug"
    },
    "requirements": {
      "$ref": "#/$defs/requirements"
    },
    "authority_url": {
      "$ref": "#/$defs/httpsUrl"
    },
    "selected_manufacturer": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "selected_mpn": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "source_id": {
      "$ref": "#/$defs/identifier"
    },
    "artifact_kinds": {
      "type": "array",
      "items": {
        "enum": ["datasheet", "drawing", "cad", "product-page", "reference-design", "price-observation"]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "retention": {
      "enum": ["archive", "normalized-observation-only"]
    },
    "status": {
      "enum": ["pending", "satisfied", "unavailable"]
    },
    "evidence_ids": {
      "$ref": "#/$defs/evidenceIdentifiers"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "request_kind": {
            "const": "manufacturer-evidence"
          }
        },
        "required": ["request_kind"]
      },
      "then": {
        "properties": {
          "request_id": {
            "$ref": "#/$defs/manufacturerRequestIdentifier"
          },
          "source_id": {
            "$ref": "#/$defs/manufacturerSourceIdentifier"
          },
          "artifact_kinds": {
            "type": "array",
            "items": {
              "enum": ["datasheet", "drawing", "cad", "product-page", "reference-design"]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "retention": {
            "const": "archive"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "request_kind": {
            "const": "uk-availability"
          }
        },
        "required": ["request_kind"]
      },
      "then": {
        "properties": {
          "request_id": {
            "$ref": "#/$defs/availabilityRequestIdentifier"
          },
          "source_id": {
            "$ref": "#/$defs/availabilitySourceIdentifier"
          },
          "artifact_kinds": {
            "const": ["price-observation"]
          },
          "retention": {
            "const": "normalized-observation-only"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "pending"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "evidence_ids": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "satisfied"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "evidence_ids": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unavailable"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "evidence_ids": {
            "maxItems": 0
          },
          "notes": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    }
  ]
}
